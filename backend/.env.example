# ─── SERVER ───────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins
# Example: https://recruitit.es,https://www.recruitit.es
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# ─── RATE LIMITING ────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_MAX=5
# Window duration in milliseconds (3600000 = 1 hour)
RATE_LIMIT_WINDOW_MS=3600000

# ─── NODEMAILER / SMTP ────────────────────────────
# Use your email provider's SMTP settings
# Gmail example: smtp.gmail.com:587 with app password
# Brevo/Sendgrid/Mailgun also work — just change host/port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password

# ─── EMAIL ADDRESSES ──────────────────────────────
# Where notifications land (Recruit IT team inbox)
NOTIFY_TO=info@recruitit.es
# From address shown to recipients
EMAIL_FROM="Recruit IT <noreply@recruitit.es>"
# Reply-To for the notification email
EMAIL_REPLY_TO=info@recruitit.es

# ─── OPTIONAL: HONEYPOT FIELD ─────────────────────
# Name of the hidden field used for bot detection
HONEYPOT_FIELD=website
